System sprint2_problem

/*
 * MODELLO DELL'ANALISTA DEL PROBLEMA
 */

// --- Messaggi ereditati dallo Sprint 1 ---
Request loadrequest : loadrequest(IOPORT_STATE)
Reply retrylater    : retrylater(CAUSE, HOLD_STATE) for loadrequest
Reply reject        : reject(HOLD_STATE) for loadrequest
Reply engaged       : engaged(RESERVED_SLOT, HOLD_STATE) for loadrequest

Dispatch button_pushed    : button_pushed(X)
Dispatch containerSensed  : containerSensed(X)
Dispatch updateHoldDisplay : updateHoldDisplay(STATE, HOLD_STATE, MSG)

// --- Nuovi messaggi definiti nell'Analisi dello Sprint 2 ---
Request transportContainer : transportContainer(SLOT, TARGETX, TARGETY)
Reply transportDone        : transportDone(SLOT) for transportContainer
Reply transportFailed      : transportFailed(CAUSE) for transportContainer

// Messaggi di comunincazione definiti da RobotSmart26
Request moverobot          : moverobot(TARGETX, TARGETY, STEPTIME)
Reply moverobotdone        : moverobotok(ARG) for moverobot
Reply moverobotfailed      : moverobotfailed(PLANDONE, PLANTODO) for moverobot

// --- Contesti di Esecuzione ---
Context ctxcargoservice ip [host="localhost" port=8120]
//Context ctxrobotsmart   ip [host="127.0.0.1" port=8020] -> per l'analisi del problema faremo tutto nello stesso contesto

// 1. Mock del servizio esterno RobotSmart26 (per isolare l'analisi del problema)
QActor robotsmart_mock context ctxcargoservice {
	[#
		var Success = 10	
	#]
    State s0 initial {
        println("$name | Mock  per Analisi starting...") color green
    }
    Goto idle
    
    State idle{
    	println("$name | waiting...") color green
    }
    Transition t0 whenRequest moverobot -> handleMove
    
    State handleMove {
        println("$name | moving...") color green
        // Simula il tempo di spostamento del robot sulla griglia
        delay 3000
        // Risponde con successo simulato
        if [#Success > 0#]{
        	[# Success = Success - 1 #]
        	replyTo moverobot with moverobotdone : moverobotok($Success)
        }
        else{
        	[#
        		var Plandone = "none"
        		var Plantodo = "move"	
        	#]
        	replyTo moverobot with moverobotfailed : moverobotfailed($Plandone, $Plantodo)
        }
    }
    Goto idle
}


QActor cargorobot context ctxcargoservice {
	[#
    	var Slot = "slotX"
    	var X = 0
    	var Y = 0
    	var StepTime = 345
   	#]
    State s0 initial {
        println("$name | starting...") color cyan
    }
    Goto idle
    
    State idle{
    	println("$name | waiting for a container...") color cyan
    }
    Transition t0 whenRequest transportContainer -> executeTransportIOPort
    
    State executeTransportIOPort {
    	println("$name | collecting container...") color cyan
    	onMsg (transportContainer : transportContainer(SLOT, TARGETX, TARGETY)){
    		[#
    			Slot = payloadArg(0)
    			X = payloadArg(1).toInt()
    			Y = payloadArg(2).toInt()
    			val XIOP  = 4
        		val YIOP  = 0
    		#]
    		request robotsmart_mock -m moverobot : moverobot ($XIOP, $YIOP, $StepTime)
    	}
    }
    Transition t1
    	whenReply moverobotdone -> executeTransportSlot5
    	whenReply moverobotfailed -> handleFinish
    	
    State executeTransportSlot5{
    	[# 
    		val X5    = 2         
       		val Y5    = 5	
    	#]
    	println ("$name | deposit in slot5...") color cyan
    	request robotsmart_mock -m moverobot : moverobot ($X5, $Y5, $StepTime)
    }
    Transition t3
    	whenReply moverobotdone -> marking
    	whenReply moverobotfailed -> handleFinish
    	
    State marking{
    	println("$name | marker working...") color cyan
    }
    Transition t2
    	whenTime 5000 -> executeTransport
    
    State executeTransport{
    	println ("$name | moving to final slot") color cyan
    	request robotsmart_mock -m moverobot : moverobot ($X, $Y, $StepTime)
    }
    Transition t3
    	whenReply moverobotdone -> backHome
    	whenReply moverobotfailed -> handleFinish
    	
    State backHome{
    	[#
    		var XHOME = 0
    		var YHOME = 0
    		h.setSlotOccupied(Slot)
    	#]
    	println ("$name | going back home") color cyan
    	request robotsmart_mock -m moverobot : moverobot ($XHOME, $YHOME, $StepTime)
    }
    Transition t4
    	whenReply moverobotdone -> handleFinish
    	whenReply moverobotfailed -> handleFinish
    
    State handleFinish{
    	onMsg (moverobotdone : moverobotok(ARG)){
    		println ("$name | trasporto finito con successo") color cyan
    		replyTo transportContainer with transportDone : transportDone($Slot)
    	}
    	onMsg (moverobotfailed : moverobotfailed(PLANDONE, PLANTODO)){
    		[# var Cause = "fail_RobotSmart26" #]
    		println ("$name | trasporto fallito") color cyan
    		replyTo transportContainer with transportFailed : transportFailed($Cause)
    	}
    }
    Goto idle
}

QActor cargoservice_ridotto context ctxcargoservice{
	[#
		var Slot = "slot1"
		var X = 2
		var Y = 2
	#]
	State s0 initial {
		println("")
	}
	Goto handleContainer
	
	State handleContainer {
        println("$name | Container rilevato -> richiesta di movimento del robot") color magenta
        request cargorobot -m transportContainer : transportContainer ($Slot, $X, $Y)
    }
    Transition t0
    	whenReply transportDone -> handleTransportComplited
    	whenReply transportFailed -> handleTransportFailed
    	
    State handleTransportComplited{
    	// aggiornamento display e liberazione area sensore
    	println("$name | il container è stato prelevato, marcato e depositato nello slot assegnato") color magenta
    }
    Transition t1
    	whenTime 5000 -> handleContainer
    
    State handleTransportFailed{
    	// aggiornamento dispay e gestione dell'errore
    	println("$name | si è verificato un errore durante il trasporto. OUT OF SERVICE!") color magenta
    }
}